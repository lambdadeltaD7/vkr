0\\1\\2x\\3x^2
\end{pmatrix}
=
-\omega_1
\begin{pmatrix}
1\\-1\\1\\-1
\end{pmatrix}
+
\omega_2
\begin{pmatrix}
1\\t_1\\t_1^2\\t_1^3
\end{pmatrix}
-
\omega_3
\begin{pmatrix}
1\\t_2\\t_2^2\\t_2^3
\end{pmatrix}." data-math-source="\beta
